# Groq API Key for fast LLM inference across multi-agent workflows
# Replace with your actual key from https://console.groq.com
GROQ_API_KEY=<YOUR_GROQ_API_KEY>

# Epistemic Confidence Threshold: below this score (0.0 to 1.0), the step trips the breaker
EPISTEMIC_THRESHOLD=0.75

# Sliding Window Size: number of recent step assessments tracked for rolling health analysis
SLIDING_WINDOW_SIZE=5

# Recovery Patience: consecutive high-confidence steps required in HALF_OPEN to return to CLOSED
RECOVERY_PATIENCE=3

# FastAPI Server Host & Port
PORT=8000
HOST=127.0.0.1
