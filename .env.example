# Epistemic Circuit Breaker - Environment Configuration Template
# Copy this file to .env and configure keys

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Epistemic Circuit Breaker Hyperparameters
EPISTEMIC_TRIP_THRESHOLD=0.65
CIRCUIT_HALF_OPEN_COOLDOWN_SEC=15
CIRCUIT_SLIDING_WINDOW_SIZE=5
SEMANTIC_ENTROPY_SAMPLES=5

# LLM Providers (Optional for live inference)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
